{
  "name": "drovik-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:lan": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.lan.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test"
  },
  "private": true,
  "overrides": {
    "pacote": {
      "glob": "14.0.4",
      "minimatch": "11.0.5"
    },
    "ignore-walk": {
      "minimatch": "11.0.5"
    },
    "@tufjs/models": {
      "minimatch": "11.0.5"
    },
    "cacache": {
      "glob": "14.0.4"
    },
    "@npmcli/package-json": {
      "glob": "14.0.4"
    }
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@microsoft/signalr": "10.0.11",
    "leaflet": "1.9.4",
    "primeicons": "8.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler-cli": "21.2.26",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/leaflet": "1.9.22",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "5.9.3",
    "vitest": "^4.0.8"
  }
}
