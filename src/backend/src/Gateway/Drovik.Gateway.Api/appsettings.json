{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "identity-users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/users/{**catch-all}" }
      },
      "fleet-vehicles": {
        "ClusterId": "fleet",
        "Match": { "Path": "/api/v1/vehicles/{**catch-all}" }
      },
      "fleet-drivers": {
        "ClusterId": "fleet",
        "Match": { "Path": "/api/v1/drivers/{**catch-all}" }
      },
      "fleet-centers": {
        "ClusterId": "fleet",
        "Match": { "Path": "/api/v1/centers/{**catch-all}" }
      },
      "fleet-reservations": {
        "ClusterId": "fleet",
        "Match": { "Path": "/api/v1/reservations/{**catch-all}" }
      },
      "shipments": {
        "ClusterId": "shipment",
        "Match": { "Path": "/api/v1/shipments/{**catch-all}" }
      },
      "simulations": {
        "ClusterId": "simulation",
        "Match": { "Path": "/api/v1/simulations/{**catch-all}" }
      },
      "incidents": {
        "ClusterId": "incident",
        "Match": { "Path": "/api/v1/incidents/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "local": { "Address": "http://localhost:5201/" } }
      },
      "fleet": {
        "Destinations": { "local": { "Address": "http://localhost:5202/" } }
      },
      "shipment": {
        "Destinations": { "local": { "Address": "http://localhost:5203/" } }
      },
      "simulation": {
        "Destinations": { "local": { "Address": "http://localhost:5204/" } }
      },
      "incident": {
        "Destinations": { "local": { "Address": "http://localhost:5205/" } }
      }
    }
  }
}
